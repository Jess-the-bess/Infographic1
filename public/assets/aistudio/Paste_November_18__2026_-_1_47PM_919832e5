} from '../components/DoodleProps';
import {WebsiteLayout} from '../components/WebsiteLayout';
import {
  CLOSEUP_SCREEN,
  COLORS,
  SPRING_PRESETS,
  STROKE,
  clampedInterpolate,
} from '../theme';
import {OwnerDeskScene} from './OwnerDeskScene';

/**
 * Scene 5 (16–20s | Frames 480–599, local 0–119): Two revision rounds and launch.
 * - 16–19s (local 0–89): Fixed close-up of owner's laptop preserving exact CLOSEUP_SCREEN
 *   page layout from Scene 4B (match cut!). Two violet checkmarks appear one at a time,
 *   then site goes live with tiny multicoloured spark.
 * - 19–20s (local 90–119): Cut back to original front-left medium shot from opening.
 *   Owner smiles with finished website clearly visible; held through 20s.
 */
export const Scene5ReviewLaunch: React.FC = () => {
  const frame = useCurrentFrame();
  const {fps} = useVideoConfig();

  // Part B: 19–20s (local frames 90..119) — Return to exact opening medium shot
  if (frame >= 90) {
    const localB = frame - 90;
    const blink = localB >= 14 && localB <= 17;
    const sparkTwinkle = 0.8 + Math.sin(localB * 0.25) * 0.15;

    return (
      <OwnerDeskScene
        mode="launch"
        expression="happy"
        blink={blink}
        headTilt={-2}
        rightShoulderAngle={8}
        rightElbowAngle={-8}
        leftShoulderAngle={0}
        holdingPhone={false}
        phoneOnDesk={true}
        phoneVibrating={false}
        vibrationPhase={0}
        tapRippleProgress={0}
        paperPlaneProgress={0}
        sparkProgress={sparkTwinkle}
      />
    );
  }

  // Part A: 16–19s (local frames 0..89) — Close-up of owner's laptop
  // Check 1: pops at f 12, tick draws f 16-30
  const check1Pop =
    frame < 12
      ? 0
      : spring({
          frame: frame - 12,
          fps,
          config: SPRING_PRESETS.bouncy,
        });
  const check1Tick = clampedInterpolate(frame, [16, 30], [0, 1]);

  // Check 2: pops at f 38, tick draws f 42-56
  const check2Pop =
    frame < 38
      ? 0
      : spring({
          frame: frame - 38,
          fps,
          config: SPRING_PRESETS.bouncy,
        });
  const check2Tick = clampedInterpolate(frame, [42, 56], [0, 1]);

  // Launch spark & live indicator burst at f 62-84
  const sparkProgress = clampedInterpolate(frame, [62, 82], [0, 1]);
  const livePulseScale = clampedInterpolate(frame, [62, 86], [0, 1]);

  return (
    <svg
      width={1920}
      height={1080}
      viewBox="0 0 1920 1080"
      style={{display: 'block', backgroundColor: COLORS.bg}}
