            {/* Hand */}
            <path
              d="M -10 2 C -14 -12, -8 -24, -1 -24 C 4 -24, 6 -14, 6 -12 C 9 -20, 16 -18, 15 -8 C 19 -12, 23 -6, 18 4 C 14 12, -2 12, -10 2 Z"
