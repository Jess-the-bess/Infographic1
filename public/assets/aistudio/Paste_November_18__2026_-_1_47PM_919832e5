import React from 'react';
import {useCurrentFrame} from 'remotion';
import {clampedInterpolate} from '../theme';
import {OwnerDeskScene} from './OwnerDeskScene';

/**
 * Scene 1 (0–4s | Frames 0–119): Enquiry and first call.
 * - Owner taps trackpad -> paper-plane icon appears above laptop
 * - Phone buzzes on desk -> owner lifts phone to ear and smiles
 */
export const Scene1Enquiry: React.FC = () => {
  const frame = useCurrentFrame();

  // Subtle deterministic blink around f 38-42
  const blink = frame >= 38 && frame <= 42;

  // Tap trackpad around f 10-24
  const tapDown = clampedInterpolate(frame, [6, 14], [0, 1]);
  const tapUp = clampedInterpolate(frame, [14, 24], [0, 1]);
  const tapMotion = tapDown - tapUp;
  const tapRippleProgress = clampedInterpolate(frame, [13, 30], [0, 1]);

  // Paper plane floats up f 18-56
  const paperPlaneProgress = clampedInterpolate(frame, [18, 56], [0, 1]);

  // Phone buzzes f 58-84
  const phoneVibrating = frame >= 58 && frame <= 83;
  const vibrationPhase = frame * 1.35;

  // Hand reaches from trackpad (f 70-82) to phone, then lifts phone to ear (f 82-108)
  const reachPhone = clampedInterpolate(frame, [70, 82], [0, 1]);
  const liftToEar = clampedInterpolate(frame, [82, 108], [0, 1]);

  // Smoothly blend shoulder & elbow angles using FK math matching Owner rig
  const rightShoulderAngle =
    10 * (1 - reachPhone) - tapMotion * 4 + liftToEar * 78;
  const rightElbowAngle =
    -10 * (1 - reachPhone) + tapMotion * 7 + liftToEar * 62;

  const holdingPhone = frame >= 82;
  const phoneOnDesk = frame < 82;

  // Owner smiles warmly as phone arrives at ear (f 92+)
  const expression = frame >= 92 ? 'happy' : 'neutral';
  const headTilt = clampedInterpolate(frame, [88, 108], [0, -5]);

  return (
    <OwnerDeskScene
      mode="enquiry"
      expression={expression}
      blink={blink}
      headTilt={headTilt}
      rightShoulderAngle={rightShoulderAngle}
      rightElbowAngle={rightElbowAngle}
      leftShoulderAngle={0}
      holdingPhone={holdingPhone}
      phoneOnDesk={phoneOnDesk}
      phoneVibrating={phoneVibrating}
      vibrationPhase={vibrationPhase}
      tapRippleProgress={tapRippleProgress}
      paperPlaneProgress={paperPlaneProgress}
      sparkProgress={0}
    />
  );
};
