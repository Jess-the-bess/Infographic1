/**
 * The single small multicoloured spark allowed at launch (18-20s).
 */
export const LaunchSpark: React.FC<{
  x: number;
  y: number;
  progress: number;
  scale?: number;
}> = ({x, y, progress, scale = 1}) => {
  if (progress <= 0.01) return null;
  const burst = Math.min(1, progress * 1.4);
  const rays = [
    {angle: -90, color: COLORS.sparkCoral, len: 20},
    {angle: -35, color: COLORS.sparkAmber, len: 17},
    {angle: 20, color: COLORS.sparkMint, len: 18},
    {angle: 145, color: COLORS.sparkSky, len: 16},
    {angle: -145, color: COLORS.sparkViolet, len: 18},
  ];

  return (
    <g transform={`translate(${x}, ${y}) scale(${scale})`}>
      {/* Center 4-point star */}
      <path
        d="M 0 -13 C 2 -4, 4 -2, 13 0 C 4 2, 2 4, 0 13 C -2 4, -4 2, -13 0 C -4 -2, -2 -4, 0 -13 Z"
        fill={COLORS.sparkAmber}
        stroke={COLORS.navy}
        strokeWidth={STROKE.fine}
        strokeLinejoin="round"
        transform={`scale(${0.6 + burst * 0.4})`}
      />
      {/* Multicoloured radial doodle sparks */}
      {rays.map((ray, i) => {
        const rad = (ray.angle * Math.PI) / 180;
        const r1 = 16 + burst * 6;
        const r2 = r1 + ray.len * burst;
        return (
          <g key={i}>
            <line
              x1={Math.cos(rad) * r1}
              y1={Math.sin(rad) * r1}
              x2={Math.cos(rad) * r2}
              y2={Math.sin(rad) * r2}
              stroke={ray.color}
              strokeWidth={4.2}
              strokeLinecap="round"
            />
            <circle
              cx={Math.cos(rad + 0.18) * (r2 + 8)}
              cy={Math.sin(rad + 0.18) * (r2 + 8)}
              r={2.8 * burst}
              fill={ray.color}
            />
          </g>
        );
      })}
    </g>
  );
};
