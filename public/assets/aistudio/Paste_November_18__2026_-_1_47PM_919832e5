import {interpolate} from 'remotion';

export const VIDEO_CONFIG = {
  width: 1920,
  height: 1080,
  fps: 30,
  durationInFrames: 600,
} as const;

export const COLORS = {
  bg: '#FFFFFF',
  paper: '#FFFFFF',
  navy: '#172047',
  navyTint: '#E9ECF7',
  violet: '#8B5CF6',
  violetSoft: '#DDD6FE',
  indigo: '#3B42B8',
  indigoSoft: '#C7D2FE',
  // Used exclusively for the single small multicoloured spark at launch
  sparkCoral: '#FF5A5F',
  sparkAmber: '#FFB400',
  sparkMint: '#10B981',
  sparkSky: '#38BDF8',
  sparkViolet: '#8B5CF6',
} as const;

export const STROKE = {
  main: 4.2,
  detail: 3.0,
  fine: 2.2,
  lineCap: 'round' as const,
  lineJoin: 'round' as const,
};

export const SPRING_PRESETS = {
  snappy: {damping: 14, stiffness: 180, mass: 0.75},
  smooth: {damping: 18, stiffness: 110, mass: 0.9},
  bouncy: {damping: 10, stiffness: 200, mass: 0.7},
};

// Shared exact geometry for match cuts
export const MATCH_CARD = {
  x: 1290,
  y: 465,
  width: 250,
  height: 175,
} as const;

export const CLOSEUP_SCREEN = {
  x: 1040,
  y: 225,
  width: 700,
  height: 490,
} as const;

/**
 * Deterministic clamped interpolation helper.
 * Always clamps both ends to guarantee zero out-of-range surprises.
 */
export const clampedInterpolate = (
  frame: number,
  inputRange: [number, number],
  outputRange: [number, number]
): number => {
  return interpolate(frame, inputRange, outputRange, {
    extrapolateLeft: 'clamp',
    extrapolateRight: 'clamp',
  });
};
