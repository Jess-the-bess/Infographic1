        y={CLOSEUP_SCREEN.y - 36}
        width={CLOSEUP_SCREEN.width + 48}
        height={CLOSEUP_SCREEN.height + 64}
        rx={26}
        fill={COLORS.paper}
        stroke={COLORS.navy}
        strokeWidth={STROKE.main}
      />
      <circle
        cx={CLOSEUP_SCREEN.x + CLOSEUP_SCREEN.width / 2}
        cy={CLOSEUP_SCREEN.y - 18}
        r={5}
        fill={COLORS.navy}
      />

      {/* Laptop lower deck */}
      <path
        d={`M ${CLOSEUP_SCREEN.x - 32} ${
          CLOSEUP_SCREEN.y + CLOSEUP_SCREEN.height + 28
        } L ${CLOSEUP_SCREEN.x + CLOSEUP_SCREEN.width + 32} ${
          CLOSEUP_SCREEN.y + CLOSEUP_SCREEN.height + 28
        } L ${CLOSEUP_SCREEN.x + CLOSEUP_SCREEN.width + 58} ${
          CLOSEUP_SCREEN.y + CLOSEUP_SCREEN.height + 86
        } L ${CLOSEUP_SCREEN.x - 32} ${
          CLOSEUP_SCREEN.y + CLOSEUP_SCREEN.height + 86
        } Z`}
        fill={COLORS.paper}
        stroke={COLORS.navy}
        strokeWidth={STROKE.main}
        strokeLinejoin={STROKE.lineJoin}
      />
      <rect
        x={CLOSEUP_SCREEN.x + CLOSEUP_SCREEN.width / 2 - 76}
        y={CLOSEUP_SCREEN.y + CLOSEUP_SCREEN.height + 44}
        width={152}
        height={24}
        rx={8}
        fill={COLORS.navyTint}
        stroke={COLORS.navy}
        strokeWidth={STROKE.detail}
      />

      {/* Exact Match Cut Finished Website Layout */}
      <WebsiteLayout
        x={CLOSEUP_SCREEN.x}
        y={CLOSEUP_SCREEN.y}
        width={CLOSEUP_SCREEN.width}
        height={CLOSEUP_SCREEN.height}
        fillProgress={1}
        showLivePulse={frame >= 62}
        pulseScale={livePulseScale}
